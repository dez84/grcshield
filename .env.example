# PostgreSQL connection string used by the API routes and migration scripts.
# Local docker-compose default:
DATABASE_URL=postgresql://grc_shield:grc_shield@localhost:5432/grc_shield

# Optional: enable the AI Regulatory Explainer live model.
# When unset, the explainer falls back to a deterministic offline glossary.
OPENAI_API_KEY=

# Public site URL (used for PWA metadata and same-origin checks).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
